{
  "name": "pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Royalty Ledger event pipeline: ingest API (Lambda) -> SQS -> aggregator (Lambda) -> DynamoDB",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ingest": "node src/local/http.js",
    "aggregator": "node src/local/poller.js",
    "setup": "node src/local/setup.js",
    "redrive": "node src/local/redrive.js",
    "test": "vitest run",
    "lint": "eslint src test",
    "build": "rm -rf dist && mkdir -p dist && cp -r src package.json package-lock.json dist/ && cd dist && npm ci --omit=dev"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1151.0",
    "@aws-sdk/client-sqs": "^3.1151.0",
    "@aws-sdk/lib-dynamodb": "^3.1151.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "vitest": "^2.1.9"
  }
}
